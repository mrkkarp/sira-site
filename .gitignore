# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Payload CMS admin — local media storage (dev only; production uses
# S3-compatible storage instead, once configured).
/media

# NOTE: src/payload-types.ts is intentionally committed (not ignored).
# It's a generated artifact, but the repositories import from it and it must
# exist on a fresh checkout for the production build (Vercel) to typecheck —
# same convention as Payload's own starter templates. Regenerate after
# changing collections with: npm run payload generate:types

# typescript
*.tsbuildinfo
next-env.d.ts

# Horoshop migration exports — secrets/PII, never commit
_horoshop-export/

# Content audit output — mirrors catalogue/pricing, never commit
/_content-audit/

# Database dumps taken before migrations/backfills. Full pg_dump of the live
# Payload database — orders, leads, customer details. This repository is
# public; these must never be committed.
/_backups/

# Local editor/agent launch config
/.claude/
