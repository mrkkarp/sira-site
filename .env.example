# ODUDLAB admin — environment variables.
# Copy to .env.local and fill in real values. .env.local (and any .env*
# file) is gitignored — never commit real secrets.

# --- Required --------------------------------------------------------------

# Local Postgres connection string used by the /admin panel (Payload CMS).
# Development default matches the local `odudlab_admin` role/database
# created via Homebrew postgresql@16 — no hosting/production database has
# been chosen yet.
DATABASE_URL=postgresql://odudlab_admin:odudlab_admin_dev_pw@localhost:5432/odudlab_admin

# Long random string used to sign admin sessions/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Optional: schema push escape hatch ------------------------------------

# Payload's postgres adapter can push the config's schema straight at the
# database on connect, skipping migrations entirely. That is convenient
# against a throwaway local database and catastrophic against a shared one —
# it ALTERs the live schema with no migration file, no review, and no row in
# `payload_migrations`, so production silently drifts from src/migrations/.
# It is therefore DISABLED by default here (payload.config.ts).
#
# Set to `true` ONLY when DATABASE_URL points at a database you are willing to
# lose. Never set it in Vercel. Normal workflow for a schema change is:
#   npm run payload migrate:create <name>  &&  git add src/migrations
# PAYLOAD_DB_PUSH=true

# Public URL of this app as seen by Payload/admin + the checkout LiqPay
# callback (src/app/api/checkout/route.ts).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Canonical public origin used for ALL SEO URLs — metadataBase, canonical
# tags, hreflang alternates, sitemap.xml, Open Graph, and JSON-LD
# (src/lib/site-url.ts). REQUIRED in production: if unset it falls back to
# http://localhost:3000, which would emit broken canonical/sitemap/OG URLs.
# Set it to the live https:// origin (no trailing slash), e.g.
# https://odudlab.com — must be HTTPS so the Secure cart cookie works.
#
# It is ALSO the indexing switch: a `*.vercel.app` value here means the domain
# has not been switched over yet, so the whole deployment stays noindex (see
# src/lib/seo/indexing.ts). Setting this to the real domain at cutover turns
# canonicals, hreflang, the sitemap and indexing on together, in one edit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Manual search-engine indexing override, on top of the automatic gate above.
# The site is indexable ONLY when VERCEL_ENV=production (Vercel sets it) AND
# NEXT_PUBLIC_SITE_URL is not a *.vercel.app host; everything else emits a
# site-wide `X-Robots-Tag: noindex` and `<meta name="robots" content="noindex">`.
# Set SEO_NOINDEX=true to force noindex regardless — for a staging host that is
# not a vercel.app, or to pull the site out of the index in a hurry. Must be
# unset for launch. Leave unset/empty otherwise.
# SEO_NOINDEX=

# --- Optional (later phases) ------------------------------------------------

# --- Measurement -----------------------------------------------------------

# Google Tag Manager container (format GTM-XXXXXXX) — the ONLY vendor ID this
# codebase knows. GA4, Google Ads and the Meta pixel are tags configured
# *inside* this container, against the events in src/lib/analytics/events.ts.
# There is deliberately no NEXT_PUBLIC_GA_MEASUREMENT_ID any more: loading
# gtag.js directly as well would have configured GA4 twice on the same page
# and double-counted every session.
#
# Unset, the container never loads: no script, no request, no cookie. The
# value is format-checked, so a GA4 "G-..." ID pasted here is rejected rather
# than silently 404ing at Google.
NEXT_PUBLIC_GTM_ID=

# What ONE LEAD IS WORTH, in UAH — owner input required.
#
# Google Ads cannot bid toward value without it. Leads that name a product (a
# quote request or colour sample from a product page) already use that
# product's real price and ignore this. This covers the rest: designer
# enquiries, contact-form messages, phone and messenger taps.
#
# There is no default and none will be invented — the right number is your
# average order value times your close rate, and both are facts about this
# business. While it is unset those events are still counted, but arrive with
# no value, so value-based bidding has nothing to optimise toward.
#
# Whole hryvnia, digits only, e.g. 4200. Zero and unparseable values are
# rejected (a zero-value conversion is worse than none).
NEXT_PUBLIC_LEAD_VALUE_UAH=

# --- Meta (Facebook/Instagram) ---------------------------------------------
#
# The BROWSER pixel is NOT configured here. It is a tag inside the GTM
# container above, firing on the events in src/lib/analytics/events.ts:
#   quote_request | designer_inquiry | contact_submit | sample_request -> Lead
#   phone_click | messenger_click                                      -> Contact
#   add_to_cart                                                        -> AddToCart
#   begin_checkout                                                     -> InitiateCheckout
#   purchase                                                           -> Purchase
# See META_SETUP.md. There is deliberately no NEXT_PUBLIC_META_PIXEL_ID:
# loading the pixel from layout as well as from GTM would fire every event
# twice, and unlike the CAPI duplicates below those cannot be deduplicated.
#
# Everything in this block is SERVER-ONLY (src/lib/analytics/meta/config.ts
# opens with `server-only`) and powers the Conversions API — the server-side
# copy of each lead, which is what keeps conversions attributable when the
# browser event is blocked by an ad blocker, ITP or a declined consent banner.
# Unset, no server event is sent and nothing else changes.

# Meta dataset ("pixel") ID — digits only. The existing dataset for
# odudlab.com is 582014448861090 ("сайт odudlab.com"). Note that its
# server_last_fired_time has never been set, i.e. no server event has ever
# reached it: the old Horoshop CAPI integration was configured but never
# delivered. Confirm in Events Manager which dataset this deployment should
# write to before setting this.
# META_PIXEL_ID=

# Conversions API access token. Events Manager -> your dataset -> Settings ->
# Conversions API -> Generate access token.
#
# This is a WRITE credential for the ad account's event data. Never prefix it
# with NEXT_PUBLIC_ (that would inline it into the JavaScript bundle), never
# commit it, never paste it into a log or a support ticket. The code sends it
# in the POST body rather than the query string so it cannot end up in a proxy
# access log. Store it in Vercel as an encrypted environment variable.
# META_CAPI_ACCESS_TOKEN=

# Test Events code — Events Manager -> your dataset -> Test Events, the
# TEST##### string shown there. While set, server events appear in that tab
# and are NOT counted as conversions. Set it to verify deduplication ("the
# event shows as Deduplicated"), then UNSET it. Leaving it on in production is
# silent: events keep flowing and no campaign learns anything from them.
# META_CAPI_TEST_EVENT_CODE=

# Graph API version override. The code pins a version (see
# DEFAULT_GRAPH_API_VERSION) because an unversioned call silently follows
# whatever Meta makes current. Set this only when Meta deprecates the pinned
# one — it turns that upgrade into an env change instead of a code change.
# META_GRAPH_API_VERSION=

# Google Search Console site verification. Only needed if you verify via the
# "HTML tag" method (see GOOGLE_SEARCH_CONSOLE_SETUP.md) — paste the token
# from the <meta name="google-site-verification" content="..."> value GSC
# shows. Leave unset if you verify by DNS TXT or HTML-file upload instead.
GOOGLE_SITE_VERIFICATION=

# Email provider — required for password-reset emails, new-login
# notifications, and admin-invite emails. Leave unset in local dev; the
# admin still works without it (reset links just won't be emailed).
# EMAIL_FROM=
# RESEND_API_KEY=

# Where the Phase E forms API (/api/callback, /api/quote) sends new-lead
# notifications. Leave unset in local dev — that endpoint falls back to
# logging to the console instead of emailing anyone (see
# src/lib/email/lead-notification-adapter.ts). Also requires EMAIL_FROM
# and RESEND_API_KEY above to actually send.
# LEADS_NOTIFICATION_EMAIL=

# S3-compatible object storage — required in production for media
# uploads. Leave unset in dev; Media collection falls back to local disk.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Shopify — only if/when Shopify becomes the commerce source of truth.
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ADMIN_API_TOKEN=

# LiqPay — only if/when online card payment is enabled.
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=

# Optional Telegram adapter for admin notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
